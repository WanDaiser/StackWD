---
/**
 * Tüm sayfaların iskeleti: meta etiketleri, hreflang, Open Graph, tema ve font ön yüklemesi.
 */
import '../styles/global.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import { languages, langs, defaultLang, type Lang } from '../i18n/ui';
import { homeAlternates, useTranslations, type Alternates } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
  alternates?: Alternates;
  structuredData?: Record<string, unknown>;
}

const { lang, title, description, noindex = false, alternates = homeAlternates(), structuredData } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og.png', Astro.site ?? site.url).href;
---

<!doctype html>
<html lang={languages[lang].htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      {
        try {
          const s = localStorage.getItem('color-scheme');
          if (s === 'light') {
            document.documentElement.dataset.theme = s;
            document.querySelector('meta[name="color-scheme"]').content = s;
          }
        } catch (e) {}
      }
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      !noindex &&
        langs.map((code) => (
          <link rel="alternate" hreflang={languages[code].htmlLang} href={new URL(alternates[code], site.url).href} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], site.url).href} />}

    <meta name="theme-color" content="#0d0e10" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {
      langs
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={languages[code].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/smooth-scroll';
    </script>
  </body>
</html>
