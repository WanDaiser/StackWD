---
/**
 * Phosphor "light" ikonları. Yeni ikon gerekirse aşağıdaki listeye içe aktarılarak eklenir.
 * El ile çizilmiş ikon yolu kullanılmaz.
 */
import arrowUpRight from '@phosphor-icons/core/assets/light/arrow-up-right-light.svg?raw';
import arrowRight from '@phosphor-icons/core/assets/light/arrow-right-light.svg?raw';
import sun from '@phosphor-icons/core/assets/light/sun-light.svg?raw';
import moon from '@phosphor-icons/core/assets/light/moon-light.svg?raw';
import list from '@phosphor-icons/core/assets/light/list-light.svg?raw';
import x from '@phosphor-icons/core/assets/light/x-light.svg?raw';
import globe from '@phosphor-icons/core/assets/light/globe-light.svg?raw';
import envelope from '@phosphor-icons/core/assets/light/envelope-light.svg?raw';
import phone from '@phosphor-icons/core/assets/light/phone-light.svg?raw';
import whatsapp from '@phosphor-icons/core/assets/light/whatsapp-logo-light.svg?raw';
import buildings from '@phosphor-icons/core/assets/light/buildings-light.svg?raw';
import rocketLaunch from '@phosphor-icons/core/assets/light/rocket-launch-light.svg?raw';
import shoppingBag from '@phosphor-icons/core/assets/light/shopping-bag-light.svg?raw';
import appWindow from '@phosphor-icons/core/assets/light/app-window-light.svg?raw';
import penNib from '@phosphor-icons/core/assets/light/pen-nib-light.svg?raw';
import arrowsClockwise from '@phosphor-icons/core/assets/light/arrows-clockwise-light.svg?raw';
import gauge from '@phosphor-icons/core/assets/light/gauge-light.svg?raw';
import wrench from '@phosphor-icons/core/assets/light/wrench-light.svg?raw';
import plus from '@phosphor-icons/core/assets/light/plus-light.svg?raw';
import check from '@phosphor-icons/core/assets/light/check-light.svg?raw';
import warningCircle from '@phosphor-icons/core/assets/light/warning-circle-light.svg?raw';
import arrowLeft from '@phosphor-icons/core/assets/light/arrow-left-light.svg?raw';
import arrowDown from '@phosphor-icons/core/assets/light/arrow-down-light.svg?raw';
import arrowUp from '@phosphor-icons/core/assets/light/arrow-up-light.svg?raw';
import paperPlaneTilt from '@phosphor-icons/core/assets/light/paper-plane-tilt-light.svg?raw';

const icons = {
  'arrow-up-right': arrowUpRight,
  'arrow-right': arrowRight,
  sun,
  moon,
  list,
  x,
  globe,
  envelope,
  phone,
  whatsapp,
  'buildings': buildings,
  'rocket-launch': rocketLaunch,
  'shopping-bag': shoppingBag,
  'app-window': appWindow,
  'pen-nib': penNib,
  'arrows-clockwise': arrowsClockwise,
  'gauge': gauge,
  'wrench': wrench,
  'plus': plus,
  'check': check,
  'warning-circle': warningCircle,
  'arrow-left': arrowLeft,
  'arrow-down': arrowDown,
  'arrow-up': arrowUp,
  'paper-plane-tilt': paperPlaneTilt,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
const svg = icons[name].replace(
  '<svg ',
  `<svg aria-hidden="true" focusable="false" class="${className}" `,
);
---

<Fragment set:html={svg} />
