---
/**
 * Süreç: dikey zaman çizgisi. Başlık masaüstünde solda sabit kalır, adımlar sağda akar.
 * Adımları bağlayan çizgi kaydırmayla dolar (CSS scroll-driven, desteklenmezse dolu görünür).
 * Her adım hero'daki katmanlardan birine karşılık gelir.
 */
import { content } from '../i18n/content';
import type { Lang } from '../i18n/ui';
import { sectionIds } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].process;
const ISO = 'matrix(0.866 0.5 -0.866 0.5 0 0)';
---

<section id={sectionIds.process} class="py-(--section)" aria-labelledby="process-title">
  <div class="container-page grid gap-x-6 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <div class="reveal lg:sticky lg:top-[calc(var(--header-h)+48px)]">
        <h2 id="process-title" class="max-w-[14ch] text-display-lg">{c.title}</h2>
        <p class="mt-6 max-w-[44ch] text-lead text-body">{c.lead}</p>
      </div>
    </div>

    <div class="process-list relative mt-14 lg:col-span-7 lg:mt-2">
      <div class="rail pointer-events-none absolute top-5 bottom-5 left-[21px] w-px bg-hairline" aria-hidden="true">
        <div class="rail-fill absolute inset-0 origin-top bg-accent"></div>
      </div>

      <ol class="relative" role="list">
      {
        c.steps.map((step, i) => (
          <li class="reveal relative grid grid-cols-[44px_1fr] gap-x-6 pb-14 last:pb-0 md:gap-x-8 md:pb-20">
            <span class="relative z-10 grid size-11 place-items-center rounded-full border border-hairline-strong bg-canvas" aria-hidden="true">
              <svg viewBox="0 0 28 28" class="size-6">
                {[0, 1, 2, 3].map((n) => (
                  <g transform={`translate(14 ${20 - n * 4}) ${ISO}`}>
                    <rect
                      x="-6"
                      y="-6"
                      width="12"
                      height="12"
                      rx="1"
                      fill={n === 3 - i ? 'var(--accent)' : 'none'}
                      stroke={n === 3 - i ? 'var(--accent)' : 'var(--hairline-strong)'}
                      stroke-width="1.2"
                      vector-effect="non-scaling-stroke"
                    />
                  </g>
                ))}
              </svg>
            </span>
            <div class="pt-1.5">
              <p class="font-mono text-small text-muted">{step.layer}</p>
              <h3 class="mt-1 text-display-md">{step.name}</h3>
              <p class="mt-4 max-w-[56ch] text-body">{step.text}</p>
              <dl class="mt-6 grid gap-4 border-t border-hairline pt-5 sm:grid-cols-2 sm:gap-8">
                <div>
                  <dt class="text-small text-muted">{c.youLabel}</dt>
                  <dd class="mt-1 text-small text-ink">{step.you}</dd>
                </div>
                <div>
                  <dt class="text-small text-muted">{c.deliverableLabel}</dt>
                  <dd class="mt-1 text-small text-ink">{step.deliverable}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style>
  .process-list {
    view-timeline: --process block;
  }
  @keyframes rail-fill {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .rail-fill {
        animation: rail-fill linear both;
        animation-timeline: --process;
        animation-range: cover 20% cover 75%;
      }
    }
  }
</style>
