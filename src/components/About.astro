---
/** Hakkında: tek sütunlu editoryal metin ve yanında çalışma ilkeleri. Ad ve fotoğraf kullanılmaz. */
import { content } from '../i18n/content';
import type { Lang } from '../i18n/ui';
import { sectionIds } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].about;
---

<section id={sectionIds.about} class="py-(--section)" aria-labelledby="about-title">
  <div class="container-page grid gap-x-6 gap-y-14 lg:grid-cols-12">
    <div class="reveal lg:col-span-7">
      <h2 id="about-title" class="max-w-[16ch] text-display-lg">{c.title}</h2>
      <p class="mt-10 max-w-[30ch] font-display text-display-md text-ink">{c.statement}</p>
      <p class="mt-8 max-w-[56ch] text-lead text-body">{c.body}</p>
    </div>

    <div class="reveal lg:col-span-4 lg:col-start-9 lg:pt-3">
      <h3 class="font-sans text-small font-medium text-muted">{c.valuesTitle}</h3>
      <dl class="mt-4 border-t border-hairline">
        {
          c.values.map((v) => (
            <div class="border-b border-hairline py-5">
              <dt class="font-medium text-ink">{v.title}</dt>
              <dd class="mt-1 text-small text-body">{v.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
