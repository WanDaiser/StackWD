---
/**
 * SSS: yerel <details> akordeonu. Aynı name değeri tek seferde bir yanıtın açık kalmasını sağlar.
 * Kapalı yanıtlar sayfa içi aramada bulunur. Açılma animasyonu hareket tercihine saygılıdır.
 */
import Icon from './Icon.astro';
import { content } from '../i18n/content';
import type { Lang } from '../i18n/ui';
import { sectionIds } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].faq;
---

<section id={sectionIds.faq} class="border-t border-hairline py-(--section)" aria-labelledby="faq-title">
  <div class="container-page grid gap-x-6 gap-y-12 lg:grid-cols-12">
    <div class="reveal lg:col-span-4">
      <h2 id="faq-title" class="max-w-[12ch] text-display-lg">{c.title}</h2>
      <p class="mt-6 max-w-[36ch] text-lead text-body">{c.lead}</p>
    </div>

    <div class="reveal border-t border-hairline lg:col-span-8">
      {
        c.items.map((item) => (
          <details name="faq" class="faq-item group border-b border-hairline">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lead font-medium text-ink [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <span class="faq-icon mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-hairline text-muted transition-[rotate,border-color,color] duration-(--dur-base) ease-out group-open:rotate-45 group-open:border-accent group-open:text-accent">
                <Icon name="plus" class="size-4" />
              </span>
            </summary>
            <div class="faq-answer">
              <p class="max-w-[62ch] pr-12 pb-7 text-body">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item summary:hover .faq-icon {
    border-color: var(--hairline-strong);
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports selector(::details-content) {
      .faq-item::details-content {
        block-size: 0;
        overflow-y: clip;
        transition:
          block-size var(--dur-base) var(--ease-out),
          content-visibility var(--dur-base) allow-discrete;
      }
      .faq-item[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
