---
/**
 * Vaka görseli. Görsel eklenmişse optimize edilmiş <Image>, yoksa açıkça işaretlenmiş yer tutucu.
 * Yer tutucu, markanın katman motifini üç farklı tonda kullanır. Sahte ekran görüntüsü çizmez.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cover?: ImageMetadata;
  alt?: string;
  tone: 'accent' | 'grid' | 'rings';
  pendingLabel: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const { cover, alt = '', tone, pendingLabel, sizes = '100vw', priority = false, class: className = '' } = Astro.props;
const ISO = 'matrix(0.866 0.5 -0.866 0.5 0 0)';
---

{
  cover ? (
    <Image
      src={cover}
      alt={alt}
      sizes={sizes}
      widths={[480, 800, 1200, 1600, 2000]}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class:list={['size-full object-cover', className]}
    />
  ) : (
    <div class:list={['cover-placeholder relative grid size-full place-items-center overflow-hidden', `tone-${tone}`, className]}>
      <svg class="h-[62%] w-auto max-w-[80%]" viewBox="0 0 400 320" aria-hidden="true" focusable="false">
        {tone === 'accent' &&
          [0, 1, 2].map((i) => (
            <g transform={`translate(200 ${210 - i * 58}) ${ISO}`}>
              <rect
                x="-90"
                y="-90"
                width="180"
                height="180"
                rx="6"
                fill={i === 2 ? 'color-mix(in oklab, var(--accent) 22%, var(--surface))' : 'var(--surface)'}
                fill-opacity="0.9"
                stroke={i === 2 ? 'var(--accent)' : 'var(--hairline-strong)'}
                stroke-width="1.2"
                vector-effect="non-scaling-stroke"
              />
            </g>
          ))}
        {tone === 'grid' && (
          <g transform={`translate(200 160) ${ISO}`}>
            <rect x="-120" y="-120" width="240" height="240" rx="6" fill="var(--surface)" stroke="var(--hairline-strong)" stroke-width="1.2" vector-effect="non-scaling-stroke" />
            {Array.from({ length: 25 }, (_, n) => (
              <rect
                x={-104 + (n % 5) * 42}
                y={-104 + Math.floor(n / 5) * 42}
                width="32"
                height="32"
                rx="4"
                fill={[1, 7, 8, 13, 19, 23].includes(n) ? 'var(--accent)' : 'none'}
                stroke="var(--ink)"
                stroke-opacity={[1, 7, 8, 13, 19, 23].includes(n) ? '0' : '0.28'}
                stroke-width="1.2"
                vector-effect="non-scaling-stroke"
              />
            ))}
          </g>
        )}
        {tone === 'rings' && (
          <g transform={`translate(200 160) ${ISO}`} fill="none" stroke="var(--ink)" stroke-width="1.2" vector-effect="non-scaling-stroke">
            <rect x="-120" y="-120" width="240" height="240" rx="6" fill="var(--surface)" stroke="var(--hairline-strong)" />
            <circle r="100" opacity="0.2" />
            <circle r="76" opacity="0.35" />
            <circle r="52" opacity="0.55" />
            <circle r="26" fill="var(--accent)" stroke="none" />
          </g>
        )}
      </svg>
      <span class="absolute bottom-4 left-4 font-mono text-[0.75rem] text-muted md:bottom-5 md:left-5">{pendingLabel}</span>
    </div>
  )
}

<style>
  .cover-placeholder {
    background-color: var(--surface);
  }
  .tone-accent {
    background:
      radial-gradient(70% 80% at 50% 40%, color-mix(in oklab, var(--accent) 20%, transparent), transparent 70%),
      var(--surface);
  }
  .tone-grid {
    background:
      linear-gradient(var(--hairline) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--hairline) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--surface);
  }
  .tone-rings {
    background:
      radial-gradient(60% 70% at 70% 30%, color-mix(in oklab, var(--ink) 7%, transparent), transparent 70%),
      var(--surface);
  }
</style>
