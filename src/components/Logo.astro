---
/** Kelime markası ve üç katmanlı basit geometrik işaret. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5 text-ink', className]}>
  <svg class="size-7 shrink-0" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
    <path d="M14 15.5 25 21l-11 5.5L3 21z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" opacity="0.45"></path>
    <path d="M14 9.5 25 15l-11 5.5L3 15z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" opacity="0.7"></path>
    <path d="M14 3.5 25 9l-11 5.5L3 9z" fill="var(--accent)" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round"></path>
  </svg>
  <span class="font-display text-[1.3125rem] leading-none font-[560] tracking-[-0.03em]">StackWD</span>
</span>
