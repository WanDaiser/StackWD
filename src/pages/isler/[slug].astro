---
import CasePage from '../../components/CasePage.astro';
import { getStaticCasePaths, type WorkEntry } from '../../lib/work';

export async function getStaticPaths() {
  return getStaticCasePaths('tr');
}

interface Props {
  entry: WorkEntry;
  next?: WorkEntry;
}
const { entry, next } = Astro.props;
---

<CasePage lang="tr" entry={entry} next={next} />
